{
  "name": "tfview",
  "version": "0.1.0",
  "description": "Review Terraform plan diffs with GitHub-style \"Viewed\" checkboxes that survive re-plans",
  "type": "module",
  "bin": {
    "tfview": "dist/tfview.js"
  },
  "files": [
    "dist/tfview.js",
    "README.md"
  ],
  "scripts": {
    "build": "rolldown -c",
    "typecheck": "tsc",
    "test": "vitest run",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "terraform",
    "opentofu",
    "plan",
    "review",
    "diff"
  ],
  "license": "MIT",
  "volta": {
    "node": "24.22.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "happy-dom": "^21.0.3",
    "hono": "^4.13.13",
    "rolldown": "^1.2.14",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
