{
  "name": "@k-kojima-yumemi/tfview",
  "version": "0.1.3",
  "description": "Review Terraform plan diffs with GitHub-style \"Viewed\" checkboxes that survive re-plans",
  "type": "module",
  "bin": {
    "tfview": "dist/tfview.js"
  },
  "files": [
    "dist/tfview.js",
    "README.md",
    "README_ja.md"
  ],
  "scripts": {
    "build": "rolldown -c",
    "format": "biome check --write --unsafe",
    "ci": "biome ci && tsc --noEmit",
    "test": "vitest run",
    "prepare": "npm run build"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.2 || >=26.13.0"
  },
  "keywords": [
    "terraform",
    "opentofu",
    "plan",
    "review",
    "diff"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/k-kojima-yumemi/tfview-html.git"
  },
  "homepage": "https://github.com/k-kojima-yumemi/tfview-html",
  "bugs": {
    "url": "https://github.com/k-kojima-yumemi/tfview-html/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "volta": {
    "node": "24.22.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@types/node": "^24.19.2",
    "happy-dom": "^21.0.4",
    "hono": "^4.13.13",
    "rolldown": "^1.2.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
